---
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Head from '@/components/Head.astro';
import Hero from '@/components/Hero.astro';
import '../styles/base.css';
import type { HeroImage } from '@/types';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	headerImage?: string | undefined;
	hideHeader?: boolean | undefined;
	hideFooter?: boolean | undefined;
	heroImage?: HeroImage | undefined;
	fullWidth?: boolean | undefined;
	noindex?: boolean | undefined;
	markdownPath?: string | undefined;
	canonical?: string | undefined;
}

const {
	heroImage,
	title = '',
	description,
	hideHeader,
	hideFooter,
	headerImage,
	fullWidth,
	noindex,
	markdownPath,
	canonical,
} = Astro.props;
---

<html lang="en">
	<Head
		title={title}
		description={description}
		headerImage={headerImage}
		noindex={noindex}
		markdownPath={markdownPath}
		canonical={canonical}
	/>
	<ClientRouter />
	<script is:inline>
		(function () {
			function resolveTheme() {
				return localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
			}
			function applyTheme() {
				document.documentElement.classList.toggle('dark', resolveTheme() === 'dark');
			}
			applyTheme();
			document.addEventListener('astro:after-swap', applyTheme);
		})();
	</script>
	<body class:list={['font-sans', 'font-normal', 'bg-paper', 'text-ink', 'flex', 'min-h-screen', 'flex-col']}>
		<!--
		THESIS: One human practice radiates into four evidence paths; refuse the generic portfolio grid and the sci-fi dashboard.
		OWN-WORLD: Cool paper or violet-black fields, documentary photography, precise hairline tracks, and purple/teal signals.
		STORY: Meet Nick, understand AI-native DX, verify it through Build/Teach/Write/Speak, then explore workshops.
		FIRST VIEWPORT: Documentary field evidence owns the left field; an oversized thesis and four sparse evidence tracks occupy the right, with Workshops as the primary action.
		FORM: The Single Event, composition C “Field Evidence”; seed 74d60bf5.
		FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
		-->
		{!hideHeader && <Header transition:persist />}
		{heroImage && <Hero title={title} alt={heroImage.alt} darkOverlay={heroImage.darkOverlay} image={heroImage.img} />}
		<main class:list={['z-30 mb-auto', !fullWidth && 'px-6']}>
			{fullWidth ? <slot /> : <div class="mx-auto max-w-4xl">{<slot />}</div>}
		</main>
		{!hideFooter && <Footer />}
	</body>
</html>
