---
import BaseLayout from '@/layouts/Base.astro';
import { getAsset } from '@/utils/image.js';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Callout from '@/components/Callout.astro';
import CopyableContent from '@/components/CopyableContent.astro';
import Appearances from '@/components/sections/Appearances.astro';
import Projects from '@/components/sections/Projects.astro';
import metadata from '@/data/metadata.json';

const profileImg = await getAsset(metadata.profile);
const socials = Object.entries(metadata.social).filter(([, { hidden }]) => !hidden);
---

<BaseLayout
	title="About Nick Nisi"
	description="Nick Nisi is a staff engineer and engineering manager working at the intersection of AI adoption, developer experience, and software practice."
	fullWidth
>
	<!-- Hero -->
	<section class="mx-auto max-w-4xl px-6 pt-12 pb-10 md:pt-16">
		<div class="grid items-center gap-8 md:grid-cols-[1.4fr_1fr] md:gap-12">
			<div>
				<h1 class="text-6xl leading-[0.9] font-extrabold tracking-tight md:text-8xl">About Nick.</h1>

				<p class="mt-5 max-w-[28ch] font-display text-xl leading-snug font-bold text-ink md:text-2xl">
					I build the systems and practices that help technical teams work differently with AI.
				</p>

				<p class="mt-3 max-w-[52ch] text-ink-soft">
					Staff engineer, engineering manager, TypeScript advocate, conference organizer, and long-time developer-tooling community voice.
				</p>

				<div class="mt-8 flex flex-wrap gap-3">
					<a href="/resume" class="btn btn-primary">View my resume →</a>
					<a href="/speaking" class="btn btn-ghost">Speaking</a>
				</div>
			</div>

			<div class="justify-self-center md:justify-self-end">
				<div class="w-[clamp(220px,26vw,300px)] overflow-hidden rounded-lg border border-line bg-card shadow-soft">
					<Image
						src={profileImg}
						alt="Nick Nisi"
						width={600}
						height={600}
						quality="max"
						class="aspect-square h-full w-full object-cover"
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- Story -->
	<section class="mx-auto max-w-4xl px-6 pb-14">
		<div class="max-w-[60ch] space-y-4 text-lg leading-relaxed text-ink-soft [&_a:hover]:decoration-tomato [&_a]:font-bold [&_a]:text-ink [&_a]:underline [&_a]:decoration-marigold [&_a]:decoration-2 [&_a]:underline-offset-4">
			<p>
				Hi! I'm Nick Nisi, dad of two, husband, and an engineering manager on the DX / AI team at <a href="https://workos.com">WorkOS</a>. I build internal harnesses and developer systems that help teams put AI to work safely and repeatably.
			</p>
			<p>
				You might know me from co-hosting the <a href="https://jsparty.fm">JS Party</a> podcast, or from organizing
				<a href="https://nejsconf.com">NEJS Conf</a> and <a href="https://archive.tsconf.io/2021/">TypeScript Conf</a>.
				These days I run the <a href="https://nebraskajs.com">NebraskaJS</a> meetup, stream weekly on
				<a href="https://www.youtube.com/nicknisi">YouTube</a>, and focus on AI-native developer experience, tooling, and TypeScript.
			</p>
			<details class="mt-6 text-sm">
				<summary class="cursor-pointer font-bold text-ink">A small non-technical footnote</summary>
				<p class="mt-3">I've also officiated {metadata.officiantCount} weddings. Turns out conference emceeing transfers surprisingly well.</p>
			</details>
			<p>
				Connect with me on <a href="https://bsky.app/profile/nicknisi.com">Bluesky</a>,
				<a href="https://github.com/nicknisi">GitHub</a>, or <a href="https://linkedin.com/in/nicknisi">LinkedIn</a>.
				Response times may vary.
			</p>
		</div>

		<div class="mt-8 max-w-[60ch]">
			<Callout title="Looking for my resume?">
				<p>You can find it at <a href="/resume">nicknisi.com/resume</a>.</p>
			</Callout>
		</div>
	</section>

	<!-- Speaking -->
	<section class="mx-auto max-w-4xl px-6 pb-14">
		<div class="mb-7 flex items-baseline gap-4">
			<h2 class="text-3xl font-extrabold md:text-4xl">Speaking</h2>
			<a href="/speaking/all" class="ml-auto font-display font-bold text-ink-soft decoration-tomato decoration-2 underline-offset-4 hover:text-ink hover:underline">
				all talks →
			</a>
		</div>
		<Appearances promoted limit={6} />
	</section>

	<!-- Projects -->
	<section class="mx-auto max-w-4xl px-6 pb-14">
		<h2 class="mb-7 text-3xl font-extrabold md:text-4xl">Projects</h2>
		<Projects promoted />
	</section>

	<!-- Press Kit -->
	<section class="mx-auto max-w-4xl px-6 pb-14">
		<h2 class="text-3xl font-extrabold md:text-5xl">Press kit</h2>
		<p class="mt-3 max-w-[60ch] text-ink-soft">A few different versions of my bio that you can use.</p>

		<div class="mt-7 grid gap-6 md:grid-cols-2">
			<div>
				<h3 class="mb-3 flex items-center gap-2 font-mono text-xs tracking-wide text-ink-soft uppercase">
					<span class="inline-block h-2.5 w-2.5 rounded-full border-[1.5px] border-ink bg-marigold"></span>
					First person
				</h3>
				<CopyableContent padding border>
					<p>
						Hey, I'm Nick! I'm a staff engineer and engineering manager on the DX / AI team at <a href="https://workos.com">WorkOS</a>. I build internal harnesses, tools, and workflows that help teams work effectively with AI, then teach those practices through hands-on workshops, talks, writing, and a weekly stream.
					</p>
					<p>
						I'm also a long-time TypeScript advocate and community builder. I've organized NEJS Conf and TypeScript Conf, emcee'd more than a dozen events, and previously co-hosted the JS Party podcast.
					</p>
				</CopyableContent>
			</div>

			<div>
				<h3 class="mb-3 flex items-center gap-2 font-mono text-xs tracking-wide text-ink-soft uppercase">
					<span class="inline-block h-2.5 w-2.5 rounded-full border-[1.5px] border-ink bg-sky"></span>
					Third person
				</h3>
				<CopyableContent padding border>
					<p>
						Nick Nisi is a staff engineer and engineering manager on the DX / AI team at <a href="https://workos.com">WorkOS</a>, where he builds internal harnesses and developer systems for AI-native work. He teaches these practices through hands-on workshops, technical talks, writing, and a weekly stream. A long-time TypeScript advocate and community builder, Nick has organized NEJS Conf and TypeScript Conf, emcee'd more than a dozen conferences, and previously co-hosted the JS Party podcast.
					</p>
				</CopyableContent>
			</div>
		</div>
	</section>

	<!-- Connect -->
	<section class="mx-auto max-w-4xl px-6 pb-16">
		<h2 class="mb-7 text-3xl font-extrabold md:text-4xl">Connect</h2>
		<div class="flex flex-wrap gap-3">
			{
				socials.map(([name, { url }]) => (
					<a
						href={url}
						target="_blank"
						rel="me noopener"
						class="tactile inline-flex items-center gap-2.5 rounded-full border-2 border-ink bg-card px-4 py-2 font-display font-bold text-ink no-underline shadow-hard-sm"
					>
						<Icon name={`simple-icons:${name}`} class="h-5 w-5" />
						<span class="capitalize">{name}</span>
					</a>
				))
			}
		</div>
	</section>
</BaseLayout>
