---
import BaseLayout from '@/layouts/Base.astro';
import { Image } from 'astro:assets';
import metadata from '@/data/metadata.json';
import profileImage from '@/assets/profile.jpg';
import LinkButton from '@/components/LinkButton.astro';
---
<BaseLayout title="Studio links" description="Recording links for Nick Nisi podcast guests." hideFooter>
	<section class="mx-auto max-w-2xl py-16 text-center md:py-24">
		<Image alt="Nick Nisi" src={profileImage} width={256} height={256} class="mx-auto size-36 rounded-lg border border-line object-cover"/>
		<h1 class="mt-7 text-6xl">Studio links</h1>
		<p class="mx-auto mt-5 max-w-[46ch] text-lg text-ink-soft">Thank you for being a guest. Choose the studio link from your invitation; it opens directly in your browser.</p>
		<div class="mt-10 space-y-2">{metadata.podcast.map(({name,studio,icon})=><LinkButton title={name} url={studio} icon={icon}/>)}</div>
		<p class="mt-10 text-sm text-ink-faint">Technical trouble? Email {metadata.author.email}.</p>
	</section>
</BaseLayout>
