---
import {getCollection} from 'astro:content';import PageLayout from '@/layouts/Page.astro';
const jobs=await getCollection('jobs');
---
<PageLayout title="Jobs"><p class="mb-10 max-w-[56ch] text-lg text-ink-soft">Open roles from the archive.</p><div class="border-t border-line">{jobs.map(job=><article class="grid gap-2 border-b border-line py-5 sm:grid-cols-[1fr_auto] sm:items-baseline"><h2 class="text-2xl">{job.data.position}</h2><span class="font-mono text-xs text-ink-faint">{job.data.name}</span></article>)}</div></PageLayout>
