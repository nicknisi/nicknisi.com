---
import Base from '@/layouts/Base.astro';
---
<Base hideFooter>
	<section class="mx-auto flex max-w-2xl flex-col items-start gap-6 px-2 py-20 md:py-32">
		<h1 class="text-7xl md:text-9xl">Lost the <span class="text-purple-600 dark:text-purple-300">thread.</span></h1>
		<p class="max-w-[42ch] text-lg leading-relaxed text-ink-soft">This page wandered off, or maybe it never existed. Either way, there’s nothing to read here.</p>
		<div class="signal-rule w-full"></div>
		<div class="flex flex-wrap gap-3"><a href="/" class="btn btn-primary">Back home →</a><a href="/posts" class="btn btn-ghost">Read the writing</a></div>
	</section>
</Base>
<script>document.addEventListener('DOMContentLoaded',()=>fathom.trackEvent(`404: ${window.location.pathname}`));</script>
