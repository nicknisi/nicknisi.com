---
import PageLayout from '@/layouts/Page.astro';
import Appearances from '@/components/sections/Appearances.astro';
---

<PageLayout title="Speaking & workshops">
	<p class="mb-12 max-w-[58ch] text-xl leading-relaxed text-ink-soft">Technical talks, hands-on workshops, panels, and live demonstrations from a long-running public practice—now focused on AI-native developer experience and the systems around it.</p>
	<Appearances limit={9} />
	<section class="mt-20 border-t border-line pt-10">
		<h2 class="max-w-[12ch] text-4xl md:text-6xl">Bring the practice into the room.</h2>
		<p class="mt-5 max-w-[58ch] text-lg text-ink-soft">Looking for an organization-wide workshop? Start with the workshop format. Planning a conference or technical event? Email me directly.</p>
		<div class="mt-7 flex flex-wrap gap-3"><a href="/workshops" class="btn btn-primary">Explore workshops</a><a href="mailto:nick@nisi.org" class="btn btn-ghost">Invite Nick to speak</a></div>
	</section>
</PageLayout>
