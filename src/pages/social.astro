---
import BaseLayout from '@/layouts/Base.astro';
import { Image } from 'astro:assets';
import metadata from '@/data/metadata.json';
import profileImage from '@/assets/profile.jpg';
import { Icon } from 'astro-icon/components';
import LinkButton from '@/components/LinkButton.astro';
import { getUTM,setUTM } from '@/utils/utm';
const utm={...getUTM(Astro.url),content:'social_linkroll'};
---
<BaseLayout title="Links" description="Find Nick Nisi around the web." hideFooter>
	<section class="mx-auto max-w-2xl py-16 text-center md:py-24">
		<a href="/" class="inline-flex rounded-lg"><Image alt="Nick Nisi" src={profileImage} width={256} height={256} class="size-36 rounded-lg border border-line object-cover"/></a>
		<h1 class="mt-6 text-6xl">Nick Nisi</h1><p class="mx-auto mt-4 max-w-[40ch] text-lg text-ink-soft">{metadata.description}</p>
		<div class="mt-7 flex flex-wrap justify-center gap-3">{Object.entries(metadata.social).filter(([,v])=>!v.hidden).map(([type,{url}])=><a href={url} aria-label={type} class="grid size-11 place-items-center rounded-md border border-line bg-card text-ink transition-colors hover:border-purple-500"><Icon name={`simple-icons:${type}`} class="size-5"/></a>)}</div>
		<div class="mt-10 space-y-2">{metadata.links.map(({title,url,icon})=><LinkButton title={title} url={setUTM(url,utm).toString()} icon={icon}/>)}</div>
	</section>
</BaseLayout>
