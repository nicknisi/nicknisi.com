---
import { Icon } from 'astro-icon/components';
interface Props { title:string; url:string; icon?:string; }
const { title,url,icon } = Astro.props;
---
<a href={url} target="_blank" rel="noopener noreferrer" data-type="social-link" class="group mx-auto flex min-h-14 w-full max-w-lg items-center gap-4 border-y border-line px-3 py-4 font-bold text-ink no-underline hover:border-purple-500">
	{icon && <Icon name={icon} class="size-6 text-teal-600 dark:text-teal-400" />}
	<span>{title}</span><Icon name="mdi:arrow-top-right" class="ml-auto size-5 text-purple-600 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 dark:text-purple-300" />
</a>
