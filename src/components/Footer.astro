---
import metadata from '../data/metadata.json';
import { DateTime } from 'luxon';
import { getAsset } from '@/utils/image.js';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

const year = DateTime.local().year;
const beef = await getAsset(metadata.avatar);
const socials = Object.entries(metadata.social).filter(([, { hidden }]) => !hidden);
---

<footer class="mt-24 border-t border-line bg-paper-2">
	<div class="mx-auto max-w-7xl px-5 py-14 md:px-8 md:py-20">
		<div class="grid gap-12 md:grid-cols-[1.2fr_.8fr] md:items-end">
			<div>
				<div class="mb-5 flex items-center gap-3">
					<Image src={beef} alt="Nick's pixel-art beef guy" width={48} height={48} quality="max" class="pixelated h-12 w-12 object-contain" />
					<span class="evidence-label">Field note complete</span>
				</div>
				<h2 class="max-w-[13ch] text-4xl md:text-6xl">Help your team build differently with AI.</h2>
				<div class="mt-7 flex flex-wrap gap-3">
					<a href="/workshops" class="btn btn-primary">Explore workshops →</a>
					<a href={`mailto:${metadata.author.email}`} class="btn btn-ghost">Email Nick</a>
				</div>
			</div>
			<div class="grid grid-cols-2 gap-7 text-sm sm:grid-cols-3 md:justify-self-end">
				<nav class="flex flex-col gap-3" aria-label="Footer navigation">
					<strong>Explore</strong>
					<a href="/posts" class="text-ink-soft no-underline hover:text-ink">Writing</a>
					<a href="/speaking" class="text-ink-soft no-underline hover:text-ink">Speaking</a>
					<a href="/about" class="text-ink-soft no-underline hover:text-ink">About</a>
				</nav>
				<div class="flex flex-col gap-3">
					<strong>Elsewhere</strong>
					{socials.slice(0,4).map(([name,{url}]) => <a href={url} target="_blank" rel="me noopener" class="capitalize text-ink-soft no-underline hover:text-ink">{name}</a>)}
				</div>
				<div class="flex flex-col gap-3">
					<strong>Business</strong>
					<span class="text-ink-soft">Typed Void LLC</span>
					<a href="https://sideeffects.dev" class="text-ink-soft no-underline hover:text-ink">Side Effects ↗</a>
				</div>
			</div>
		</div>
		<div class="mt-14 flex flex-col gap-3 border-t border-line pt-6 text-sm text-ink-faint sm:flex-row sm:items-center sm:justify-between">
			<p>© {year} Nick Nisi · Made in Nebraska</p>
			<p class="flex items-center gap-2"><Icon name="mdi:signal" class="h-4 w-4 text-teal-500" /> AI-native DX, in practice.</p>
		</div>
	</div>
</footer>

<style>.pixelated{image-rendering:pixelated}</style>
