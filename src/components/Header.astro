---
import metadata from '../data/metadata.json';
import { getAsset } from '@/utils/image.js';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import ThemeToggle from '@/components/ThemeToggle.astro';

const beef = await getAsset(metadata.avatar);
const links = [
	{ href: '/posts', label: 'Writing' },
	{ href: '/speaking', label: 'Speaking' },
	{ href: '/about', label: 'About' },
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/92 backdrop-blur-md">
	<div class="mx-auto flex h-[68px] max-w-7xl items-center gap-4 px-5 md:px-8">
		<a href="/" class="group flex min-w-0 items-center gap-3 no-underline" aria-label="Nick Nisi, home">
			<span class="grid h-10 w-10 shrink-0 place-items-center overflow-hidden rounded-md border border-line bg-card transition-transform duration-200 group-hover:-translate-y-0.5">
				<Image src={beef} alt="" width={40} height={40} quality="max" class="pixelated h-9 w-9 object-contain" />
			</span>
			<span class="truncate font-display text-lg font-extrabold tracking-[-0.035em] text-ink">Nick Nisi</span>
		</a>

		<nav class="ml-auto hidden items-center gap-7 md:flex" aria-label="Primary navigation">
			{
				links.map(({ href, label }) => (
					<a href={href} class:list={['nav-underline text-sm font-bold text-ink no-underline', path.startsWith(href) && 'active']}>
						{label}
					</a>
				))
			}
			<a href="/workshops" class="btn btn-primary">Workshops</a>
		</nav>

		<ThemeToggle />
		<button id="navToggle" type="button" class="grid h-10 w-10 place-items-center rounded-md border border-line text-ink md:hidden" aria-label="Toggle navigation" aria-expanded="false" aria-controls="mobileNav">
			<Icon name="mdi:menu" class="menu-icon h-5 w-5" />
			<Icon name="mdi:close" class="close-icon hidden h-5 w-5" />
		</button>
	</div>
	<nav id="mobileNav" class="hidden border-t border-line bg-paper px-5 py-4 md:hidden" aria-label="Mobile navigation">
		<div class="mx-auto flex max-w-7xl flex-col gap-1">
			<a href="/workshops" class="mb-2 btn btn-primary">Explore workshops</a>
			{links.map(({ href, label }) => <a href={href} class="rounded-md px-3 py-3 font-bold text-ink no-underline hover:bg-paper-2">{label}</a>)}
		</div>
	</nav>
</header>

<style>
	.pixelated { image-rendering: pixelated; }
	#navToggle[aria-expanded='true'] .menu-icon { display:none; }
	#navToggle[aria-expanded='true'] .close-icon { display:block; }
</style>

<script is:inline>
	function wireNav() {
		const button = document.getElementById('navToggle');
		const nav = document.getElementById('mobileNav');
		if (!button || !nav || button.dataset.wired) return;
		button.dataset.wired = 'true';
		const close = () => { nav.classList.add('hidden'); button.setAttribute('aria-expanded','false'); };
		button.addEventListener('click', () => {
			const open = nav.classList.toggle('hidden') === false;
			button.setAttribute('aria-expanded', String(open));
		});
		nav.querySelectorAll('a').forEach(link => link.addEventListener('click', close));
	}
	document.addEventListener('astro:page-load', wireNav);
	wireNav();
</script>
