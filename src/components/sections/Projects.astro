---
import Project from '@/components/cards/Project.astro';
import { getCollection } from 'astro:content';
interface Props { limit?: number; promoted?: boolean; }
const { limit, promoted } = Astro.props;
let projects = await getCollection('projects');
if (promoted) projects = projects.filter(project=>project.data.promote).slice(0,limit);
else if (limit) projects = projects.slice(0,limit);
---
<div class="grid grid-cols-1 gap-x-8 sm:grid-cols-2 lg:grid-cols-3">{projects.map(project=><Project project={project} />)}</div>
