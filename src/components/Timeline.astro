---
import Video from '@/components/Video.astro';
interface TimelineEvent { time:string; text:string; image?:string; video?:string; link?:string; }
interface Props { events:Array<TimelineEvent>; reverse?:boolean; }
const { events, reverse }=Astro.props;
const ordered=reverse?[...events].reverse():events;
---
<section class="not-prose">
	<ol class="mx-auto max-w-2xl list-none border-t border-line px-0">
		{ordered.map(event=><li class="grid gap-4 border-b border-line py-7 sm:grid-cols-[9rem_1fr]">
			<time class="font-mono text-xs tracking-wide text-ink-faint uppercase">{event.time}</time>
			<div>
				{event.text&&<p class="m-0 font-display text-xl font-bold text-ink">{event.text}</p>}
				{event.image&&<img src={event.image} alt={event.text} class="mt-4 max-h-56 rounded-lg border border-line" />}
				{event.link&&<a href={event.link} class="mt-4 inline-flex font-bold text-purple-600 underline decoration-teal-500 decoration-1 underline-offset-4 dark:text-purple-300">Link →</a>}
				{event.video&&<div class="mt-4"><Video videoId={event.video}/></div>}
			</div>
		</li>)}
	</ol>
</section>
