---
interface Props { name: string; size?: 'small'|'large'|'base'; }
const { name, size = 'small' } = Astro.props;
---
<a href={`/tags/${name}`} class:list={['not-prose inline-flex items-center gap-1 border-b border-line py-1 font-mono tracking-wide text-ink-soft uppercase no-underline hover:border-teal-500 hover:text-ink',size==='small'?'text-xs':size==='base'?'text-sm':'text-base']}><span class="text-purple-600 dark:text-purple-300">#</span>{name.toLowerCase()}</a>
