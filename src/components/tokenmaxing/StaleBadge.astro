---
interface Props { generatedAt:string; }
const {generatedAt}=Astro.props;
const stale=Date.now()-new Date(generatedAt).getTime()>14*24*60*60*1000;
---
{stale&&<span class="ml-2 inline-flex border-b border-purple-500 font-mono text-xs tracking-wide text-purple-700 uppercase dark:text-purple-300">Data may be stale</span>}
