---
import type { CollectionEntry } from 'astro:content';
interface Props { weeks: CollectionEntry<'tokenmaxing'>['data']['weeklyHighlights']; }
const { weeks }=Astro.props;
---
<section class="mt-16"><h2 class="text-4xl">Weekly highlights</h2>
	{weeks.length===0&&<p class="mt-5 text-ink-soft">No public PRs in this period.</p>}
	<div class="mt-8 space-y-10">{weeks.map(w=><div><h3 class="evidence-label">Week of {w.weekEnding}</h3>{w.summary&&<p class="mt-3 text-ink-soft">{w.summary}</p>}<ul class="mt-4 list-none border-t border-line px-0">{w.pullRequests.map(pr=><li class="grid gap-2 border-b border-line py-4 sm:grid-cols-[auto_1fr_auto] sm:items-baseline"><span class="font-mono text-xs tracking-wide text-purple-600 uppercase dark:text-purple-300">{pr.state}</span><a href={pr.url} class="font-mono text-sm text-ink underline decoration-teal-500 decoration-1 underline-offset-4" target="_blank" rel="noopener">{pr.repo}#{pr.number} · {pr.title}</a><span class="font-mono text-xs"><span class="text-teal-700 dark:text-teal-300">+{pr.additions}</span> <span class="text-purple-700 dark:text-purple-300">-{pr.deletions}</span></span></li>)}</ul></div>)}</div>
</section>
