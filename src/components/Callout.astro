---
import { Icon } from 'astro-icon/components';
interface Props { title?: string; variant?: keyof typeof variants; }
const variants = {
	default: { icon: 'mdi:message-outline', line: 'border-purple-500' },
	info: { icon: 'mdi:information-slab-circle-outline', line: 'border-teal-500' },
	warning: { icon: 'mdi:alert-outline', line: 'border-purple-500' },
	success: { icon: 'mdi:check-circle-outline', line: 'border-teal-500' },
	error: { icon: 'mdi:x-circle-outline', line: 'border-purple-500' },
} as const;
const { title, variant = 'default' } = Astro.props;
const { icon, line } = variants[variant];
---

<aside class:list={['not-prose border-y border-line border-l py-5 pr-5 pl-6 text-ink', line]}>
	<div class="flex items-start gap-3">
		<Icon name={icon} class="mt-0.5 h-5 w-5 shrink-0 text-teal-600 dark:text-teal-400" />
		<div class="min-w-0 flex-1 [&_a]:font-bold [&_a]:text-purple-600 [&_a]:underline [&_a]:decoration-teal-500 [&_a]:decoration-1 [&_a]:underline-offset-2 dark:[&_a]:text-purple-300">
			{title && <p class="m-0 font-display text-lg font-bold text-ink">{title}</p>}
			<div class:list={['font-sans text-base leading-relaxed text-ink-soft', title && 'mt-1.5']}><slot /></div>
		</div>
	</div>
</aside>
