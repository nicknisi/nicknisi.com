---
import { type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
interface Props { project: CollectionEntry<'projects'>; }
const { data: { name,url,roles,description,status,image } } = Astro.props.project;
---
<a href={url} target="_blank" rel="noopener" class="group flex flex-col border-t border-line py-6 text-ink no-underline">
	{image && <Image src={image} alt="" width={560} height={300} class="mb-5 h-28 w-full object-contain object-left" />}
	<span class="evidence-label">{status === 'active' ? 'Active project' : 'Archive project'}</span>
	<h3 class="mt-3 text-2xl decoration-teal-500 decoration-1 underline-offset-4 group-hover:underline">{name}</h3>
	{description && <p class="mt-3 text-sm leading-relaxed text-ink-soft">{description}</p>}
	<div class="mt-auto flex flex-wrap gap-x-4 gap-y-2 pt-5 font-mono text-[.7rem] tracking-wide text-ink-faint uppercase">{roles.map(role=><span>{role}</span>)}</div>
</a>
