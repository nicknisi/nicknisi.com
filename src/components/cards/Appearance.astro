---
import { type CollectionEntry } from 'astro:content';
import { getThumbnail } from '@/utils/image.js';
import { Image } from 'astro:assets';
import { toReadableDate } from '@/utils/common';

interface Props { appearance: CollectionEntry<'appearances'>; }
const { appearance: talk } = Astro.props;
const { slug } = talk;
const { type, title, instances, detailsUrl } = talk.data;
const thumbnail = await getThumbnail(talk.data);
const hasMultipleInstances = instances.length > 1;
const firstInstance = instances[0]!;
const href = detailsUrl || (hasMultipleInstances ? `/speaking/${slug}` : firstInstance.url);
---

<a href={href} class="group flex flex-col border-t border-line pt-5 text-ink no-underline">
	{thumbnail && <div class="mb-5 overflow-hidden rounded-md border border-line"><Image src={thumbnail} alt="" width={640} height={360} class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" /></div>}
	<span class="evidence-label">{type} · {toReadableDate(firstInstance.date)}</span>
	<h3 class="mt-3 text-2xl decoration-teal-500 decoration-1 underline-offset-4 group-hover:underline">{title}</h3>
	<p class="mt-3 text-sm text-ink-soft">{hasMultipleInstances ? `${instances.length} appearances` : `${firstInstance.event} · ${firstInstance.location}`}</p>
	<span class="mt-auto pt-5 text-sm font-bold text-purple-600 dark:text-purple-300">View →</span>
</a>
