---
import FormattedDate from '@/components/FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';

interface Props { post: CollectionEntry<'posts'>; hideImage?: boolean; featured?: boolean; }
const { post } = Astro.props;
const href = post.data.external ?? `/posts/${post.id}`;
const tag = post.data.tags?.[0] ?? 'writing';
---

<a href={href} transition:name={`post-${post.id}`} class="group flex min-h-52 flex-col border-t border-line py-6 text-ink no-underline transition-colors hover:border-purple-500">
	<span class="flex items-center justify-between gap-4 font-mono text-xs tracking-wide text-ink-faint uppercase">
		<span>{tag}</span>
		<span><FormattedDate date={post.data.pubDate} />{post.data.external && ' · external ↗'}</span>
	</span>
	<h3 class="mt-5 text-[1.65rem] leading-[1.03] tracking-[-.035em] decoration-teal-500 decoration-1 underline-offset-4 group-hover:underline">{post.data.title}</h3>
	{post.data.description && <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-ink-soft">{post.data.description}</p>}
	<span class="mt-auto pt-6 text-sm font-bold text-purple-600 dark:text-purple-300">Read →</span>
</a>
